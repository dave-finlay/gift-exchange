# Caddy, in front of the app: HTTPS for the site's domains, with
# certificates from Let's Encrypt, renewed automatically; plain HTTP
# redirects to HTTPS. SITE_DOMAIN and EXTRA_DOMAINS come from site.env.
{
	# Nothing changes Caddy's configuration while it runs.
	admin off
}

{$SITE_DOMAIN} {$EXTRA_DOMAINS} {
	# The app works out the client's address from X-Forwarded-For, which
	# Caddy sets to the address it sees, ignoring any sent by the client.
	reverse_proxy app:8000

	# The admin site isn't public. Operators use django-admin commands on
	# the server instead (see docs/SELF-HOSTING.md).
	respond /admin* 404

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Requests are logged without participants' private links: the token
	# in /p/<token>/ is replaced, and Referer (which could hold one) is
	# dropped. The app itself keeps no request log.
	log {
		format filter {
			request>uri regexp ^/p/[^/?]+ /p/…
			request>headers>Referer delete
		}
	}
}
