# Site settings for one installation, read by both containers. Copy to
# /etc/gift-exchange/site.env and fill in. Nothing here is secret: keys
# and passwords go in /etc/gift-exchange/secrets (see docs/SELF-HOSTING.md).

# The site's domain. Caddy gets its certificate for it, and the app
# answers only to it (and EXTRA_DOMAINS).
SITE_DOMAIN=giftexchange.example

# Optional: more domains for the same site, separated by spaces. Each
# gives links on its own domain.
#EXTRA_DOMAINS=kriskindle.example

# Shown in page titles, email subjects and signatures.
SITE_NAME=Gift Exchange

# The email provider: any that django-anymail supports, by the name of its
# Anymail backend. Its keys go in secret files (mailjet_api_key and
# mailjet_secret_key for Mailjet).
EMAIL_PROVIDER=mailjet

# Who emails come from. The domain must be verified with the provider.
EMAIL_FROM=Gift Exchange <hello@giftexchange.example>

# The privacy note and the contact address shown to users.
OPERATOR_NAME=
OPERATOR_EMAIL=

# The default time zone for dates.
TIME_ZONE=Europe/Dublin

# Optional: size limits (these are the defaults).
#MAX_CIRCLES_PER_USER=5
#MAX_PEOPLE_PER_CIRCLE=50
#MAX_EXCHANGES_PER_CIRCLE_PER_YEAR=4
#MAX_EXCHANGES_PER_USER=10
#MAX_EMAILS_PER_EXCHANGE_PER_DAY=150
#INVITATION_DAYS=7

# Optional: gunicorn's worker processes (default 3).
#WEB_WORKERS=3
