# The app image on Alpine Linux: the same app as the Dockerfile's, on a
# smaller base with fewer packages (musl rather than glibc). Published
# alongside it with an -alpine suffix on each tag (main-alpine,
# 0.11.0-alpine), so the two can be compared, and a site can run either.
# Base images are pinned by digest (a tag can be moved); Dependabot keeps
# them current.

FROM ghcr.io/astral-sh/uv:0.13.8@sha256:5cc1805e2426484abca4ad46ea783bab281fdb225fd82d8ce6d66a81254bac85 AS uv

# Build: install the app and its locked dependencies into /app/.venv, and
# collect the static files. The dependencies with compiled parts
# (cryptography, argon2-cffi) come as wheels built for musl, so nothing
# is compiled here.
FROM python:3.13-alpine@sha256:9ef1a599f863231c3d91e941389bfdc4a2d6070557243d54df1a4e57015b960e AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv
WORKDIR /src
# Dependencies first, so they're cached when only the app changes.
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project
COPY README.md LICENSE ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable
RUN DJANGO_DEBUG=1 DATA_DIR=/tmp/data STATIC_ROOT=/app/static \
    /app/.venv/bin/django-admin collectstatic --noinput \
    --settings giftexchange.settings

# Run: the same base, without uv or the source, as an unprivileged user.
# CI builds this stage without its layer cache (image.yml), so that
# the upgrade below runs every time.
FROM python:3.13-alpine@sha256:9ef1a599f863231c3d91e941389bfdc4a2d6070557243d54df1a4e57015b960e AS run
# Alpine's security fixes, which reach its package repository before the
# base image is rebuilt with them. Upgraded rather than pinned (as the
# Dockerfile does for zlib): Alpine keeps only the newest version of each
# package, so a pinned one disappears with the next fix and breaks the
# build. So each build, daily included, has the newest packages of the
# base's Alpine release, and its SBOM records which.
RUN apk upgrade --no-cache
RUN addgroup -S -g 10001 app \
    && adduser -S -u 10001 -G app -H -s /sbin/nologin app \
    && mkdir /data && chown app:app /data
COPY --from=build /app /app
COPY deploy/start.sh /app/start.sh
ENV PATH=/app/.venv/bin:$PATH \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=giftexchange.settings \
    DATA_DIR=/data \
    STATIC_ROOT=/app/static \
    SECRETS_DIR=/run/secrets
USER app
WORKDIR /data
EXPOSE 8000
CMD ["/app/start.sh"]
